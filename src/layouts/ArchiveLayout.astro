---
// One page of an archive (src/lib/archives.ts): its posts, newest first, and
// links to the pages with newer and older posts.
import { getEntries } from 'astro:content';
import type { ArchivePage } from '../lib/archives';
import { displayTitle, formatSiteDate, postPath } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
	page: ArchivePage;
}

const { page } = Astro.props;
// The home page's heading is the site name, which the site header shows already.
const isHome = page.archive.path === '/';
// WordPress (AIOSEO) kept the pages after the first out of search results.
const robots = page.number > 1 ? 'noindex, nofollow, max-image-preview:large' : undefined;
const posts = await Promise.all(
	page.posts.map(async (post) => ({ post, categories: await getEntries(post.data.categories) })),
);
---

<BaseLayout
	title={page.title}
	description={page.description}
	breadcrumbs={isHome ? undefined : [{ name: page.archive.name, path: page.archive.path }]}
	robots={robots}
>
	<Fragment slot="head">
		{page.newer && <link rel="prev" href={page.newer} />}
		{page.older && <link rel="next" href={page.older} />}
	</Fragment>
	<h1 class:list={['archive-heading', { 'sr-only': isHome }]}>{page.archive.heading}</h1>
	<div class="posts">
		{
			posts.map(({ post, categories }) => (
				<article>
					<p class="meta">
						<time datetime={post.data.published.toISOString()}>{formatSiteDate(post.data.published)}</time>
						{categories.map((category) => (
							<a href={`/category/${category.id}/`} rel="category tag">
								{category.data.name}
							</a>
						))}
					</p>
					<h2>
						<a href={postPath(post)} rel="bookmark">
							{displayTitle(post.data.title)}
						</a>
					</h2>
					<p class="excerpt">{post.data.excerpt ?? post.data.description}</p>
				</article>
			))
		}
	</div>
	{
		page.count > 1 && (
			<nav class="pagination" aria-label="文章分頁">
				{page.newer ? <a href={page.newer}>← 較新的文章</a> : <span />}
				<span class="position">
					第 {page.number} 頁，共 {page.count} 頁
				</span>
				{page.older ? <a href={page.older}>較舊的文章 →</a> : <span />}
			</nav>
		)
	}
</BaseLayout>

<style>
	.archive-heading {
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 3px solid var(--color-frame);
		font-size: 1.5rem;
	}

	article {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--color-rule);
	}
	article:first-child {
		padding-top: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		margin: 0 0 0.4rem;
		color: var(--color-muted);
		font-size: 0.875rem;
	}
	.meta a {
		text-decoration: none;
	}
	.meta a:hover {
		text-decoration: underline;
	}

	h2 {
		margin: 0 0 0.6rem;
		font-size: 1.375rem;
		line-height: 1.45;
	}
	h2 a {
		color: var(--color-text);
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--color-link);
		text-decoration: underline;
	}

	.excerpt {
		margin: 0;
		color: #3d3d3d;
		line-height: 1.8;
	}

	.pagination {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		margin-top: 2.5rem;
		font-size: 0.9375rem;
	}
	.pagination a {
		justify-self: start;
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-rule);
		border-radius: 0.25rem;
		text-decoration: none;
	}
	.pagination a:last-child {
		justify-self: end;
	}
	.pagination a:hover {
		border-color: var(--color-link);
	}
	.position {
		color: var(--color-muted);
	}

	@media (max-width: 40rem) {
		h2 {
			font-size: 1.2rem;
		}
		.pagination {
			grid-template-columns: 1fr 1fr;
		}
		.position {
			grid-row: 2;
			grid-column: 1 / -1;
			text-align: center;
		}
	}
</style>

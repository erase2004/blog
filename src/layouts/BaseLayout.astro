---
// Every page: the site header with the menu, the main column, the sidebar
// and the site footer.
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import type { Article, Breadcrumb } from '../lib/seo';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title: string;
	description: string;
	/** The image of the page's link previews; the site image if none. */
	image?: ImageMetadata;
	/** For a post or page: when it was published and last updated. */
	article?: Article;
	/** The trail from the home page to the page, ending with it; none for the home page. */
	breadcrumbs?: Breadcrumb[];
	/** The robots meta tag, if not the default: indexable, with large image previews. */
	robots?: string;
}

const { title, description, image, article, breadcrumbs, robots } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			article={article}
			breadcrumbs={breadcrumbs}
			robots={robots}
		/>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">跳到主要內容</a>
		<Header />
		<div class="sheet">
			<main id="main">
				<slot />
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>

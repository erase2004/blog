---
// A page, at its WordPress URL: /about/, /about/contact/, /policy/, …
import { render } from 'astro:content';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPages, type Page, pagePath } from '../lib/content';

export async function getStaticPaths() {
	return (await getPages()).map((page) => ({
		params: { page: pagePath(page).slice(1, -1) },
		props: { page },
	}));
}

const { page } = Astro.props as { page: Page };
const { Content } = await render(page);
---

<BaseLayout title={`${page.data.title} - ${SITE_TITLE}`} description={page.data.description}>
	<article data-pagefind-body>
		<h1>{page.data.title}</h1>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	h1 {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 3px solid var(--color-frame);
		font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.25rem);
	}
</style>

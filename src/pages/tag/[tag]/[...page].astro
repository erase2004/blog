---
// A tag archive, at its WordPress URL /tag/<slug>/ (/page/N/ after the first page).
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import { type ArchivePage, archivePages, pageParam, tagArchives } from '../../../lib/archives';

export async function getStaticPaths() {
	return (await tagArchives()).flatMap((archive) =>
		archivePages(archive).map((page) => ({
			params: { tag: archive.id, page: pageParam(page) },
			props: { page },
		})),
	);
}

const { page } = Astro.props as { page: ArchivePage };
---

<ArchiveLayout page={page} />

---
// A post, at its WordPress URL /YYYY/MM/DD/<slug>/.
import { getEntries, render } from 'astro:content';
import Comments from '../../../../components/Comments.astro';
import MarkdownImage from '../../../../components/MarkdownImage.astro';
import RelatedPosts from '../../../../components/RelatedPosts.astro';
import ShareLinks from '../../../../components/ShareLinks.astro';
import { SITE_TITLE } from '../../../../consts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
	formatSiteDate,
	getPosts,
	type Post,
	postDescription,
	postPath,
	postUpdated,
	siteDate,
} from '../../../../lib/content';
import { imageUrl } from '../../../../lib/images';
import { relatedPosts } from '../../../../lib/related-posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { ...siteDate(post.data.published), slug: post.data.slug },
		props: { post, related: relatedPosts(post, posts) },
	}));
}

const { post, related } = Astro.props as { post: Post; related: Post[] };
const { Content } = await render(post);
const { title, published } = post.data;
const updated = postUpdated(post);
const categories = await getEntries(post.data.categories);
const tags = await getEntries(post.data.tags);
const url = new URL(postPath(post), Astro.site).href;
const socialImage = post.data.socialImage && new URL(await imageUrl(post.data.socialImage), Astro.site).href;
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={postDescription(post)}>
	<article class="post" data-pagefind-body>
		<header class="post-header">
			<ul class="post-categories" aria-label="分類">
				{
					categories.map((category) => (
						<li>
							<a href={`/category/${category.id}/`} rel="category tag">
								{category.data.name}
							</a>
						</li>
					))
				}
			</ul>
			<h1>{title}</h1>
			<dl class="post-dates">
				<div>
					<dt>發布日期</dt>
					<dd><time datetime={published.toISOString()}>{formatSiteDate(published)}</time></dd>
				</div>
				<div>
					<dt>最後更新</dt>
					<dd><time datetime={updated.toISOString()}>{formatSiteDate(updated)}</time></dd>
				</div>
			</dl>
		</header>
		<div class="prose">
			<Content components={{ img: MarkdownImage }} />
		</div>
		{
			tags.length > 0 && (
				<footer class="post-footer">
					<h2 class="sr-only">標籤</h2>
					<ul class="post-tags">
						{tags.map((tag) => (
							<li>
								<a href={`/tag/${tag.id}/`} rel="tag">
									{tag.data.name}
								</a>
							</li>
						))}
					</ul>
				</footer>
			)
		}
	</article>
	<div class="post-after">
		<ShareLinks url={url} title={title} image={socialImage} />
		<RelatedPosts posts={related} />
		<Comments path={postPath(post)} />
	</div>
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2.25rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-rule);
	}
	.post-categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		padding: 0;
		list-style: none;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.post-categories a {
		text-decoration: none;
	}
	.post-categories a:hover {
		text-decoration: underline;
	}
	h1 {
		margin-bottom: 1rem;
		font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.25rem);
		line-height: 1.35;
	}
	.post-dates {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}
	.post-dates div {
		display: flex;
		gap: 0.5em;
	}
	.post-dates dd {
		margin: 0;
	}

	.post-footer {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-rule);
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
	}
	.post-tags a {
		display: block;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
	}
	.post-tags a::before {
		content: '#';
		margin-right: 0.15em;
		color: var(--color-muted);
	}
	.post-tags a:hover {
		background: var(--color-link);
		color: #fff;
	}
	.post-tags a:hover::before {
		color: inherit;
	}

	/*
	 * After the post, outside the <article> (and so outside the search index):
	 * share links, related posts and comments, each under its own heading.
	 */
	.post-after {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: 3rem;
	}
	.post-after > :global(section > h2) {
		margin: 0 0 1rem;
		font-size: 1.125rem;
		letter-spacing: 0.06em;
	}
</style>

---
// What every URL without a page answers with, with HTTP 404: ways on to the
// site's content. The header menu and the sidebar come with the layout.
import Search from '../components/Search.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayTitle, formatSiteDate, getPosts, postPath } from '../lib/content';

const latest = (await getPosts()).slice(0, 5);
---

<BaseLayout title={`找不到頁面 - ${SITE_TITLE}`} description="找不到這個頁面。" robots="noindex" canonical={false}>
	<h1>找不到頁面</h1>
	<p>這個網址沒有內容，可能已經移動或刪除。可以搜尋看看，或從最新的文章讀起。</p>

	{/* Its own Pagefind instance: the sidebar's box is the default one. */}
	<section class="not-found-search" role="search" aria-labelledby="not-found-search-heading">
		<h2 id="not-found-search-heading">搜尋文章</h2>
		<Search instance="not-found" />
	</section>

	<section aria-labelledby="latest-posts-heading">
		<h2 id="latest-posts-heading">最新文章</h2>
		<ul class="latest">
			{
				latest.map((post) => (
					<li>
						<a href={postPath(post)}>{displayTitle(post.data.title)}</a>
						<time datetime={post.data.published.toISOString()}>{formatSiteDate(post.data.published)}</time>
					</li>
				))
			}
		</ul>
	</section>

	<p class="home"><a href="/">回到首頁</a></p>
</BaseLayout>

<style>
	h1 {
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 3px solid var(--color-frame);
		font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.25rem);
	}
	h2 {
		font-size: 1.25rem;
	}
	section {
		margin-top: 2.5rem;
	}

	.latest {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.latest li {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--color-rule);
	}
	.latest a {
		font-weight: 700;
		text-decoration: none;
	}
	.latest a:hover {
		text-decoration: underline;
	}
	.latest time {
		color: var(--color-muted);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.home {
		margin-top: 2.5rem;
	}
</style>

---
// A before/after slider: two pictures of the same scene, one over the other,
// and a divider the reader drags (mouse or touch, or the arrow keys once it
// has focus) to show more of one or the other. It is the
// img-comparison-slider web component, whose script loads only on pages
// that have a slider. The caption, if any, is the component's content:
//
//   <Compare before={frame} after={photo}>動畫中出現的公車站</Compare>
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** Left of the divider: in the travel posts, the frame from the anime. */
	before: ImageMetadata;
	/** Right of the divider: the photo of the real place. */
	after: ImageMetadata;
}

const { before, after } = Astro.props;

// The slider takes the shape of the before image, as WordPress's (Jetpack's
// Juxtapose) did; the after image fills the same frame.
const shape = `--compare-aspect-ratio: ${before.width} / ${before.height}`;
// The images are as wide as the post's column: at most 728px beside the
// sidebar, about the screen's width without it (src/styles/global.css).
const sizes = '(min-width: 64rem) 728px, 100vw';
---

<figure class="compare">
	<img-comparison-slider style={shape}>
		<div slot="first"><Image src={before} alt="" sizes={sizes} /></div>
		<div slot="second"><Image src={after} alt="" sizes={sizes} /></div>
	</img-comparison-slider>
	{
		Astro.slots.has('default') && (
			<figcaption>
				<slot />
			</figcaption>
		)
	}
</figure>

<script>
	import 'img-comparison-slider';
</script>

<style>
	img-comparison-slider {
		display: block;
		width: 100%;
		border-radius: 0.25rem;
		--divider-width: 2px;
		--default-handle-shadow: 0 0 3px rgb(0 0 0 / 60%);
		--divider-shadow: 0 0 3px rgb(0 0 0 / 60%);
	}
	img-comparison-slider :global(img) {
		display: block;
		width: 100%;
		max-width: none;
		height: auto;
		margin: 0;
		aspect-ratio: var(--compare-aspect-ratio);
		object-fit: cover;
		border-radius: 0;
	}
	/* Until its script has run, it looks the same, the divider in the middle. */
	img-comparison-slider:not(:defined) {
		position: relative;
		overflow: hidden;
	}
	img-comparison-slider:not(:defined) [slot='first'] {
		position: absolute;
		inset: 0;
		z-index: 1;
		clip-path: inset(0 50% 0 0);
	}
</style>

---
// A YouTube video that costs nothing until it is played: the video's
// thumbnail, linked to the video on YouTube, and once clicked, the player
// (from youtube-nocookie.com) in its place. Without JavaScript the link
// opens the video on YouTube.
interface Props {
	/** The video ID: `x3_Pcru8SS8` for https://www.youtube.com/watch?v=x3_Pcru8SS8. */
	id: string;
	/** The video's title, for the player and screen readers. */
	title?: string;
}

const { id, title = 'YouTube 影片' } = Astro.props;
---

<div class="youtube">
	<a href={`https://www.youtube.com/watch?v=${id}`} data-youtube-id={id} data-youtube-title={title}>
		<img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
		<span class="play" aria-hidden="true"></span>
		<span class="sr-only">播放 YouTube 影片：{title}</span>
	</a>
</div>

<script>
	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-youtube-id]')) {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			const player = document.createElement('iframe');
			player.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtubeId}?autoplay=1`;
			player.title = link.dataset.youtubeTitle ?? '';
			player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			player.allowFullscreen = true;
			player.referrerPolicy = 'strict-origin-when-cross-origin';
			link.replaceWith(player);
			player.focus();
		});
	}
</script>

<style>
	.youtube {
		margin: 1em 0;
	}
	.youtube a,
	.youtube :global(iframe) {
		display: block;
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
		background: #000;
	}
	.youtube img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* YouTube's play button. */
	.play {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 68px;
		height: 48px;
		border-radius: 12px;
		background: rgb(33 33 33 / 80%);
		transition: background 0.1s;
	}
	.play::before {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 11px 0 11px 19px;
		border-color: transparent transparent transparent #fff;
		transform: translateX(2px);
	}
	.youtube a:hover .play,
	.youtube a:focus-visible .play {
		background: #f00;
	}
</style>

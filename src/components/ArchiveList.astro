---
// A list of links to archives, each with its post count: `技術 (9)`.
interface Props {
	/** What the archives are, for screen readers: `分類`, `年份`. */
	label: string;
	items: { name: string; path: string; count: number }[];
}

const { label, items } = Astro.props;
---

<nav aria-label={label}>
	<ul>
		{
			items.map(({ name, path, count }) => (
				<li>
					<a href={path}>{name}</a> <span class="count">({count})</span>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.45rem 0;
		border-bottom: 1px solid var(--color-rule);
	}
	a {
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	.count {
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}
</style>

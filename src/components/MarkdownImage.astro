---
// A Markdown image (`![alt](../../assets/images/…)`) in an MDX post, made
// exactly as Astro makes one in a Markdown (.md) post. MDX's own image
// component adds `fit` and `position`, which give the files other names: each
// image would be made twice, full size included, and the one a post shows
// would not be the one its old URLs redirect to (imageUrl() in
// src/lib/images.ts). The post page hands it to MDX for `img`.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

type Props = { src: ImageMetadata; alt: string } & Record<string, unknown>;

const image = await getImage(Astro.props as Props);
---

<img src={image.src} srcset={image.srcSet.attribute || undefined} {...image.attributes} />

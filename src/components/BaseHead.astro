---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import {
	type Article,
	type Breadcrumb,
	scriptJson,
	socialImage,
	socialImageFile,
	structuredData,
} from '../lib/seo';

interface Props {
	title: string;
	description: string;
	/** The image of the page's link previews; the site image if none. */
	image?: ImageMetadata;
	/** For a post or page: when it was published and last updated, and its tags. */
	article?: Article;
	/** The trail from the home page to the page; none for the home page. */
	breadcrumbs?: Breadcrumb[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, article, breadcrumbs } = Astro.props;
const image = await socialImageFile(Astro.props.image ?? (await socialImage()));
const site = new URL('/', Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<!-- The site header's colour, for the browser's toolbar on phones. -->
<meta name="theme-color" content="#1a1a1a" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<meta name="fediverse:creator" content={SITE_AUTHOR.fediverse} />
{article && <meta name="author" content={SITE_AUTHOR.name} />}

<!-- Open Graph / Facebook -->
<meta property="og:locale" content="zh_TW" />
<meta property="og:site_name" content={`${SITE_TITLE} - ${SITE_DESCRIPTION}`} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />
<meta property="og:image:type" content={image.type} />
<meta property="og:image:width" content={image.width} />
<meta property="og:image:height" content={image.height} />
{article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
{article && <meta property="article:modified_time" content={article.modified.toISOString()} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<!-- Structured data -->
<script
	type="application/ld+json"
	is:inline
	set:html={scriptJson(structuredData({ site, url: canonicalURL, description, image, article, breadcrumbs }))}
/>

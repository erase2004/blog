---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { GA4_MEASUREMENT_ID, SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import {
	type Article,
	type Breadcrumb,
	scriptJson,
	socialImage,
	socialImageFile,
	structuredData,
} from '../lib/seo';

interface Props {
	title: string;
	description: string;
	/** The image of the page's link previews; the site image if none. */
	image?: ImageMetadata;
	/** For a post or page: when it was published and last updated, and its tags. */
	article?: Article;
	/** The trail from the home page to the page; none for the home page. */
	breadcrumbs?: Breadcrumb[];
	/** The robots meta tag; by default, as on WordPress, indexable with large image previews. */
	robots?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, article, breadcrumbs, robots = 'max-image-preview:large' } = Astro.props;
const image = await socialImageFile(Astro.props.image ?? (await socialImage()));
const site = new URL('/', Astro.site);
// Google's snippet. `gtag()` is global, so that the 404 page can send an event with it.
const gtagConfig = `window.dataLayer = window.dataLayer || [];
function gtag() { dataLayer.push(arguments); }
gtag('js', new Date());
gtag('config', ${JSON.stringify(GA4_MEASUREMENT_ID)});`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- The WordPress site icon (cropped-night.png), in the sizes WordPress gave it; also /favicon.ico. -->
<link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
<link rel="icon" href="/favicon-192x192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="msapplication-TileImage" content="/mstile-270x270.png" />
<meta name="generator" content={Astro.generator} />
<!-- The site header's colour, for the browser's toolbar on phones. -->
<meta name="theme-color" content="#1a1a1a" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />

<meta name="fediverse:creator" content={SITE_AUTHOR.fediverse} />
{article && <meta name="author" content={SITE_AUTHOR.name} />}

<!-- Open Graph / Facebook -->
<meta property="og:locale" content="zh_TW" />
<meta property="og:site_name" content={`${SITE_TITLE} - ${SITE_DESCRIPTION}`} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />
<meta property="og:image:type" content={image.type} />
<meta property="og:image:width" content={image.width} />
<meta property="og:image:height" content={image.height} />
{article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
{article && <meta property="article:modified_time" content={article.modified.toISOString()} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- X: title, description and image come from Open Graph. -->
<meta name="twitter:card" content="summary" />

<!-- Structured data -->
<script
	type="application/ld+json"
	is:inline
	set:html={scriptJson(structuredData({ site, url: canonicalURL, description, image, article, breadcrumbs }))}
/>

{
	/*
	 * Google Analytics 4: the WordPress site's property, so visits before and
	 * after the move can be compared. Not in `astro dev`, so that writing
	 * posts locally does not count as visits.
	 */
	import.meta.env.PROD && (
		<>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`} />
			<script is:inline set:html={gtagConfig} />
		</>
	)
}

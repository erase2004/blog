---
// Sidebar widget: the years that have posts, newest first, with their post counts.
import { yearArchives } from '../lib/archives';
import ArchiveList from './ArchiveList.astro';

const archives = await yearArchives();
---

<ArchiveList
	label="年份"
	items={archives.map((archive) => ({ name: archive.name, path: archive.path, count: archive.posts.length }))}
/>

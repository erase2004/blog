---
// The feeds (/feed/ and /feed/atom/), for browsers and feed readers to find
// from any page. The RSS feed's title is the one WordPress gave it.
import { SITE_TITLE } from '../consts';

const url = (path: string) => new URL(path, Astro.site).href;
---

<link rel="alternate" type="application/rss+xml" title={`訂閱《${SITE_TITLE}》» 資訊提供`} href={url('/feed/')} />
<link rel="alternate" type="application/atom+xml" title={`訂閱《${SITE_TITLE}》» 資訊提供 (Atom)`} href={url('/feed/atom/')} />

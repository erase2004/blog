---
// A gallery of photos, in rows: as many photos to a row as fit, each row's
// photos equally tall and filling the column, none cropped. Clicking a photo
// opens it in a lightbox (PhotoSwipe), which goes through the gallery's
// photos with arrows, swipes or arrow keys, and shows their captions.
// Without JavaScript each photo links to the photo at full size.
//
// In MDX, each image is imported from the post's folder of the uniform image
// directory; content between the tags is a caption for the whole gallery:
//
//   import Gallery from '../../components/Gallery.astro';
//
//   <Gallery
//   	images={[
//   		{ src: import('../../assets/images/<post>/<file>.jpg'), caption: '圖說' },
//   		{ src: import('../../assets/images/<post>/<file>.jpg'), alt: '替代文字' },
//   	]}
//   />
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { imageUrl } from '../lib/images';

interface Props {
	images: {
		/** The image: `import('../../assets/images/…')`, or an imported image. */
		src: ImageMetadata | Promise<{ default: ImageMetadata }>;
		/** What the photo shows, for those who cannot see it; the caption by default. */
		alt?: string;
		/** Shown with the photo in the lightbox. */
		caption?: string;
	}[];
}

/**
 * How wide a thumbnail is, for each pixel of height it has to the width it
 * has. Rows are at least 9rem (144px) tall and stretch to fill the column, so
 * thumbnails are made for 192px of height, at 1x and 2x.
 */
const THUMBNAIL_HEIGHT = 192;
/** The lightbox's smaller size of a photo, for phones; larger screens get the photo at full size. */
const LIGHTBOX_WIDTH = 1280;

const photos = await Promise.all(
	Astro.props.images.map(async ({ src, alt, caption }) => {
		const image = 'then' in src ? (await src).default : src;
		const ratio = image.width / image.height;
		const thumbnail = await getImage({ src: image, layout: 'fixed', width: Math.round(ratio * THUMBNAIL_HEIGHT) });
		const full = await imageUrl(image);
		const smaller =
			image.width > LIGHTBOX_WIDTH ? (await getImage({ src: image, width: LIGHTBOX_WIDTH, layout: 'none' })).src : undefined;
		return {
			ratio,
			full,
			srcset: smaller ? `${smaller} ${LIGHTBOX_WIDTH}w, ${full} ${image.width}w` : undefined,
			width: image.width,
			height: image.height,
			caption,
			thumbnail: {
				...thumbnail.attributes,
				src: thumbnail.src,
				srcset: thumbnail.srcSet.attribute,
				alt: alt ?? caption ?? '',
			},
		};
	}),
);
const hasCaption = Astro.slots.has('default');
---

<figure class="gallery">
	<ul class="gallery-photos" role="list">
		{
			photos.map((photo) => (
				<li style={`--ratio: ${photo.ratio.toFixed(4)}`}>
					<a
						href={photo.full}
						data-pswp-width={photo.width}
						data-pswp-height={photo.height}
						data-pswp-srcset={photo.srcset}
						data-caption={photo.caption}
					>
						<img {...photo.thumbnail} />
					</a>
				</li>
			))
		}
	</ul>
	{
		hasCaption && (
			<figcaption>
				<slot />
			</figcaption>
		)
	}
</figure>

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import 'photoswipe/style.css';

	for (const gallery of document.querySelectorAll<HTMLElement>('.gallery-photos')) {
		const lightbox = new PhotoSwipeLightbox({
			gallery,
			children: 'a',
			// The lightbox itself loads once a photo is clicked.
			pswpModule: () => import('photoswipe'),
			closeTitle: '關閉',
			zoomTitle: '放大或縮小',
			arrowPrevTitle: '上一張',
			arrowNextTitle: '下一張',
			errorMsg: '無法載入這張照片',
			indexIndicatorSep: ' / ',
		});
		lightbox.on('uiRegister', () => {
			lightbox.pswp?.ui?.registerElement({
				name: 'caption',
				order: 9,
				isButton: false,
				appendTo: 'root',
				onInit: (element, pswp) => {
					pswp.on('change', () => {
						const caption = pswp.currSlide?.data.element?.dataset.caption ?? '';
						element.textContent = caption;
						element.hidden = caption === '';
					});
				},
			});
		});
		lightbox.init();
	}
</script>

<style>
	.gallery {
		margin: 0 0 1.4em;
	}
	.gallery-photos {
		--row-height: 9rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 40rem) {
		.gallery-photos {
			--row-height: 6.5rem;
		}
	}
	/*
	  Each photo starts as wide as it is at the row height, and takes a share of
	  the row's leftover width in proportion to that: a row's photos stay
	  equally tall, and fill it.
	*/
	.gallery-photos li {
		flex: var(--ratio) 1 calc(var(--ratio) * var(--row-height));
		min-width: 0;
		margin: 0;
	}
	/* The last row is left as it is, instead of a few photos stretched across it. */
	.gallery-photos::after {
		content: '';
		flex: 1000 1 0;
	}
	.gallery-photos a {
		display: block;
	}
	.gallery-photos img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 0.25rem;
	}
	.gallery-photos a:hover img {
		opacity: 0.85;
	}

	:global(.pswp__caption) {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		font-size: 0.9375rem;
		line-height: 1.6;
		text-align: center;
	}
</style>

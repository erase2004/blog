# Response headers for Cloudflare Workers static assets.

# The feeds are written as <path>/index.html, the file served for the URL
# with its trailing slash, so their Content-Type is set here. Like WordPress,
# they are kept out of search results.
/feed/
  Content-Type: application/rss+xml; charset=utf-8
  X-Robots-Tag: noindex, follow
/feed/atom/
  Content-Type: application/atom+xml; charset=utf-8
  X-Robots-Tag: noindex, follow
